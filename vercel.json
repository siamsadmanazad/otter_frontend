{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/cron/drain-storage-deletions",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/roll-offering-slots",
      "schedule": "15 2 * * *"
    }
  ]
}
